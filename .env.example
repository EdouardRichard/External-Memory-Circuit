# RAG MCP 环境配置模板
# 复制为 `.env` 并按需修改。`.env` 已加入 .gitignore，不会提交到仓库。
#
# 本地开发默认值（与 docker-compose.yml 一致）：无需设置即可启动，
# config.py 内置 localhost 默认值。仅在连接远程/其他环境时覆盖下列变量。

# PostgreSQL（async 引擎，服务运行时使用）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_mcp

# PostgreSQL（sync 引擎，Alembic 迁移使用）
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/rag_mcp

# Qdrant 向量库
QDRANT_URL=http://localhost:6333

# 管理面 REST API 端口（默认 8000）
MANAGEMENT_PORT=8000

# MCP Streamable HTTP 端口（默认 8080，客户端手动配置此 URL）
MCP_PORT=8080

# 上传原始文件的本地数据根目录
DATA_ROOT=./data/uploads

# Embedding 模型（本地 CPU 默认 BAAI/bge-m3，Dense 1024 维）
EMBEDDING_MODEL=BAAI/bge-m3

# =============================================================================
# 006 Runtime Hardening — 运行配置（全部有安全缺省值，可整体省略）
# =============================================================================

# 实例模式：writer（管理进程 + writer MCP）/ reader（仅只读 MCP）。默认 writer。
INSTANCE_MODE=writer

# 显式雪花 worker_id（0-1023）；留空则自动分配最低空闲 worker_id（单实例=0）。
# 两个并发活跃实例配置相同 worker_id 会被启动显式拒绝（唯一约束检测）。
# WORKER_ID=0

# Writer 单写租约：续约周期秒（默认 30）、过期窗口秒（默认 90，约续约 3 倍）。
LEASE_RENEW_INTERVAL_S=30
LEASE_EXPIRY_WINDOW_S=90

# 运行记录 TTL 天数（默认 7）；writer 管理进程 TTL 循环按此窗口清理。
RETRIEVAL_TTL_DAYS=7

# 统一正文开关（默认 true）：false 时所有检索模式运行记录 query_text 置空、
# trace_body_recorded=FALSE，ID/状态/耗时/错误仍完整保留。
# AGENTIC_TRACE_BODY_ENABLED 为 005 兼容别名。
TRACE_BODY_ENABLED=true

# ---- 三类能力 Provider 配置（各自独立选择 local_cpu / local_gpu / remote_api）----
# 默认组合：local CPU Embedding + Reranker + remote API LLM。
# 凭据仅以环境变量「名」引用，凭据值绝不进入配置结构（宪法 V）。

# Embedding Provider（默认 local_cpu / BAAI/bge-m3 / 并发 8，上限 16）
EMBEDDING_PROVIDER_TYPE=local_cpu
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_ENDPOINT=https://example.com/v1
# EMBEDDING_API_KEY_ENV=EMBEDDING_API_KEY
# EMBEDDING_CONCURRENCY_LIMIT=8
# EMBEDDING_CONCURRENCY_LIMIT_MAX=16

# Reranker Provider（默认 local_cpu / bge-reranker-v2-m3 / 并发 2，上限 4）
RERANKER_PROVIDER_TYPE=local_cpu
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_ENDPOINT=https://example.com/v1
# RERANKER_API_KEY_ENV=RERANKER_API_KEY
# RERANKER_CONCURRENCY_LIMIT=2
# RERANKER_CONCURRENCY_LIMIT_MAX=4

# ---- 在线（OpenAI 兼容云 API）示例：仅改运行配置即可切换，无需改代码 ----
# 适用形态：云端 /embeddings 与 /rerank（阿里百炼 / 硅基流动 / OpenAI 等）。
# 凭据只写「变量名」：EMBEDDING_API_KEY_ENV 填的是承载密钥的环境变量名，
# 密钥值本身放在该变量里（例如 EMBEDDING_API_KEY），不要写进 *_API_KEY_ENV。
#
# EMBEDDING_PROVIDER_TYPE=remote_api
# EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY_ENV=EMBEDDING_API_KEY
# EMBEDDING_TIMEOUT_S=30            # 云端建议 30s（Provider 构造默认值为 2s，不改默认以避免单测行为漂移）
# EMBEDDING_DIMENSION=1024          # 可选；不填则读既有集合维度，集合不存在时首次调用后由响应确定
#
# RERANKER_PROVIDER_TYPE=remote_api
# RERANKER_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# RERANKER_API_KEY_ENV=RERANKER_API_KEY
# RERANKER_TIMEOUT_S=30             # 同上：默认 2s，云端建议显式加长
#
# 重要：EMBEDDING_MODEL 决定 Qdrant 集合名（chunks_hybrid_<短名>_v1；
# 记忆投影集合名为 memories_dense_<归一化模型名>_012_v2）。
# 仅切换 Provider 类型、保持 EMBEDDING_MODEL 逐字符不变时，集合名不变，既有向量继续可用。
# 若更换模型，将生成新集合，旧向量不会参与新检索；是否需要重嵌入与清理旧集合由运维自行决定，
# 本系统不提供数据迁移工具，也不清空任何旧集合。

# LLM Provider（默认 remote_api；endpoint 未设时回退 LLM_BASE_URL）
LLM_PROVIDER_TYPE=remote_api
# LLM_MODEL=deepseek-v4-flash
# LLM_ENDPOINT=https://example.com/v1
# LLM_API_KEY_ENV=LLM_API_KEY
#
# LLM_CONCURRENCY_LIMIT / _MAX 的实际生效范围（已实测确认，非缺陷）：
#   ✅ 生效：Provider 组合（get_provider_bundle）构建的 LLM 客户端，
#            例如 writer 管理进程的巩固 Distiller（server.py 的 MemoryDistiller）。
#   ⚠️ 不生效：Agentic 检索路径（CapabilityRouter.create_client →
#            orchestration/state_machine.py 的 query_planner / evidence_analyst）。
#            该路径依据实际调用量与配额评估，判定为无需限流，故保持不限流现状。
# 因 Embedding / Reranker 两类能力的上限是完整生效的（见上方对应段落），
# 若调大 agentic 并发后出现异常，请先看这里的说明，而不是去排查限流器。
# LLM_CONCURRENCY_LIMIT=4
# LLM_CONCURRENCY_LIMIT_MAX=8

# =============================================================================
# 012–014 外置型记忆回路 — 运行配置（全部有安全缺省值，可整体省略）
# =============================================================================
# 记忆的「写入 / 显式召回 / start_work 引导包」是默认可用能力，无需开关：
#   writer MCP 注册 6 工具（含 record_memory），reader MCP 注册 5 个只读工具。
# 下列两个开关只控制 014 的「记忆感知检索」增量形态，默认关闭是发布状态：
# 只有在连续性闸门、硬指标与回归闸门全过后才进入默认路径（FR-035）。

# 014 记忆感知检索：search_knowledge 的 related_memories 附加层 + start_work 工作集新形态
MEMORY_AWARE_RETRIEVAL_ENABLED=false

# 014 文件投影消费层（memory_projection/<scope>/<kind>/<memory_id>.md + DIGEST.md + INDEX.md）
MEMORY_CONSUMPTION_PROJECTION_ENABLED=false

# 消费层根目录（默认 DATA_ROOT 的同级目录 memory_projection，禁止与 DATA_ROOT 重叠）
# MEMORY_CONSUMPTION_ROOT=./data/memory_projection

# 消费层维护窗口内的对账周期秒（30–3600，默认 300）
# MEMORY_CONSUMPTION_REFRESH_INTERVAL_S=300

# 013 巩固闸门证明的只读登记路径（默认未设置 = 无证明；巩固与链接扩展保持关闭）
# CONSOLIDATION_GATE_REGISTRY_PATH=

# ---- 每 Host Tool Call 超时档位（蓝图 §19；服务端总超时必须严格小于各 Host）----
# 默认：DeepSeek Harness 60000 / Claude Code 60000 / ChatGPT App 120000 ms，
# 服务端总超时 30000ms。反向配置（任一 Host <= 服务端总超时）启动即显式拒绝。
HOST_TIMEOUT_MS_DEEPSEEK_HARNESS=60000
HOST_TIMEOUT_MS_CLAUDE_CODE=60000
HOST_TIMEOUT_MS_CHATGPT_APP=120000
RETRIEVAL_TOTAL_TIMEOUT_MS=30000
